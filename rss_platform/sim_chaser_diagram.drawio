gn:center;&quot;&gt;revolute&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;text-align:left;&quot;&gt;wrist_2_link → wrist_3_link&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;text-align:center;&quot;&gt;(-0.000034, 0.154013, 0.000154)&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;text-align:center;&quot;&gt;(1.571796, 3.141593, 3.141592)&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;text-align:center;&quot;&gt;(0, 0, 1)&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;text-align:center;&quot;&gt;-360.0° … +360.0°&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;text-align:center;&quot;&gt;wrist_3-flange&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;text-align:center;&quot;&gt;fixed&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;text-align:left;&quot;&gt;wrist_3_link → flange&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;text-align:center;&quot;&gt;(0, 0, 0)&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;text-align:center;&quot;&gt;(0, -1.570796, -1.570796)&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;text-align:center;&quot;&gt;—&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;text-align:center;&quot;&gt;—&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;text-align:center;&quot;&gt;flange-tool0&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;text-align:center;&quot;&gt;fixed&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;text-align:left;&quot;&gt;flange → tool0&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;text-align:center;&quot;&gt;(0, 0, 0)&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;text-align:center;&quot;&gt;(1.570796, 0, 1.570796)&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;text-align:center;&quot;&gt;—&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;text-align:center;&quot;&gt;—&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;text-align:center;&quot;&gt;zimmer_grasp_frame_joint&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;text-align:center;&quot;&gt;fixed&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;text-align:left;&quot;&gt;zimmer_body → zimmer_grasp_frame&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;text-align:center;&quot;&gt;(0.0667, 0, 0)&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;text-align:center;&quot;&gt;(3.141593, 0, 0)&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;text-align:center;&quot;&gt;—&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;text-align:center;&quot;&gt;—&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;text-align:center;&quot;&gt;gripper_finger1_joint&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;text-align:center;&quot;&gt;prismatic&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;text-align:left;&quot;&gt;zimmer_body → finger_mount_left&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;text-align:center;&quot;&gt;(0.00075, 0.053, -0.011)&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;text-align:center;&quot;&gt;(3.1415, 0, 0)&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;text-align:center;&quot;&gt;(0, 1, 0)&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;text-align:center;&quot;&gt;-0.007 … +0.052 m&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;text-align:center;&quot;&gt;gripper_finger2_joint&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;text-align:center;&quot;&gt;prismatic&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;text-align:left;&quot;&gt;zimmer_body → finger_mount_right&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;text-align:center;&quot;&gt;(0.00075, -0.053, 0.011)&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;text-align:center;&quot;&gt;(0, 0, 0)&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;text-align:center;&quot;&gt;(0, 1, 0)&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;text-align:center;&quot;&gt;-0.007 … +0.052 m&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=visible;" vertex="1" parent="1"><mxGeometry x="60.0" y="465.0" width="1520.0" height="620.0" as="geometry"/></mxCell><mxCell id="c199" value="&lt;p style=&quot;font-size:13px;&quot;&gt;&lt;b&gt;Notes&lt;/b&gt;&lt;/p&gt;&lt;ul style=&quot;font-size:12px;margin-top:0;&quot;&gt;&lt;li style=&quot;margin-bottom:4px;&quot;&gt;Generalised coordinates: 6 for the floating base (pose of {P} = slide_optical_plate w.r.t. the world base_link) + 6 per arm (J1…J6) = 18. The 4 gripper-finger prismatic joints (G1/G2 on each arm) move bodies with no mass in the URDF, so they add zero rows/columns to the mass matrix: lock them, or give the fingers a mass, before deriving the equations of motion.&lt;/li&gt;&lt;li style=&quot;margin-bottom:4px;&quot;&gt;Total system mass = 5153.9915 kg (base B0 5029.2825 + 2 × arm). Base COM in {P}: (0.0017, -0.0004, 0.7019) m.&lt;/li&gt;&lt;li style=&quot;margin-bottom:4px;&quot;&gt;B0 includes the 1 × 1 × 1 m mockup (5000 kg, I = m/6 = 833.333 kg·m², COM 0.705 m above the plate), han&#x27;s ATI adapter + tombstone, chewie&#x27;s Bota top plate + tombstone, and both UR20 base_link_inertia links (4 kg each).&lt;/li&gt;&lt;li style=&quot;margin-bottom:4px;&quot;&gt;B6 = wrist_3_link + mount adapter + gripper adapter + Zimmer gripper body. It differs slightly between arms because chewie&#x27;s gripper adapter is rolled by π.&lt;/li&gt;&lt;li style=&quot;margin-bottom:4px;&quot;&gt;No mass in the URDF (treated as massless here): slide_optical_plate, F/T sensors (han_fts, chewie_fts_combined, alpha/bravo/charlie), cameras and camera mounts, cable harnesses, gripper fingers, and all frame-only links (tool0, flange, grasp frames, …).&lt;/li&gt;&lt;li style=&quot;margin-bottom:4px;&quot;&gt;Inertia values are taken from each link&#x27;s &amp;lt;inertial&amp;gt; (rotated by its rpy into the body frame and shifted to the merged COM with the parallel-axis theorem). No gravity or joint friction/damping is defined in the URDF.&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=visible;" vertex="1" parent="1"><mxGeometry x="60.0" y="1100.0" width="1520.0" height="220.0" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>