0, 0, +1.000)&lt;/td&gt;&lt;td&gt;-360° … +360°&lt;/td&gt;&lt;td&gt;(+0.005, -0.003, -1.000)&lt;/td&gt;&lt;td&gt;-360° … +360°&lt;/td&gt;&lt;td&gt;B4 (wrist_1_link)&lt;/td&gt;&lt;td&gt;3.054&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;J5&lt;/td&gt;&lt;td&gt;wrist_2&lt;/td&gt;&lt;td&gt;(-0.866, -0.500, 0)&lt;/td&gt;&lt;td&gt;-360° … +360°&lt;/td&gt;&lt;td&gt;(-0.866, +0.500, -0.005)&lt;/td&gt;&lt;td&gt;-360° … +360°&lt;/td&gt;&lt;td&gt;B5 (wrist_2_link)&lt;/td&gt;&lt;td&gt;3.126&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;J6&lt;/td&gt;&lt;td&gt;wrist_3&lt;/td&gt;&lt;td&gt;(0, 0, +1.000)&lt;/td&gt;&lt;td&gt;-360° … +360°&lt;/td&gt;&lt;td&gt;(+0.004, -0.002, -1.000)&lt;/td&gt;&lt;td&gt;-360° … +360°&lt;/td&gt;&lt;td&gt;B6 (wrist_3_link + gripper/adapters)&lt;/td&gt;&lt;td&gt;2.321&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;G1&lt;/td&gt;&lt;td&gt;gripper_finger1&lt;/td&gt;&lt;td&gt;(+0.500, -0.866, 0)&lt;/td&gt;&lt;td&gt;-0.007 … +0.052 m&lt;/td&gt;&lt;td&gt;(-0.500, -0.866, 0)&lt;/td&gt;&lt;td&gt;-0.007 … +0.052 m&lt;/td&gt;&lt;td&gt;(finger_mount_left)&lt;/td&gt;&lt;td&gt;0 (none in URDF)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;G2&lt;/td&gt;&lt;td&gt;gripper_finger2&lt;/td&gt;&lt;td&gt;(-0.500, +0.866, 0)&lt;/td&gt;&lt;td&gt;-0.007 … +0.052 m&lt;/td&gt;&lt;td&gt;(+0.500, +0.866, 0)&lt;/td&gt;&lt;td&gt;-0.007 … +0.052 m&lt;/td&gt;&lt;td&gt;(finger_mount_right)&lt;/td&gt;&lt;td&gt;0 (none in URDF)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;p style=&quot;font-family:Helvetica;font-size:12px;&quot;&gt;Link lengths (both arms, UR20): d1 = 0.236, a2 = 0.861, a3 = 0.728, d4 = 0.200, d5 = 0.159, d6 = 0.154, tool0 → grasp = 0.121 m.  Axes are expressed in slide_optical_plate at q = 0.  Chewie is mounted flipped (tombstone yaw π), so its J2/J3/J4/J6 axes point −z and d4/d6/gripper hang below the shoulder plane.  Gripper fingers are prismatic along the fingers&amp;#x27; ±axis shown.&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=visible;" vertex="1" parent="1"><mxGeometry x="220.0" y="1250.0" width="1200.0" height="290.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="parameters" name="parameters"><mxGraphModel dx="1400" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1620" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c194" value="sim_chaser.urdf: rigid bodies, inertial parameters and joint transforms (for the equations of motion)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="220.0" y="26.4" width="1200.0" height="27.2" as="geometry"/></mxCell><mxCell id="c195" value="Table 1. Rigid bodies (fixed joints merged). Inertia tensor about the body COM, expressed in the body frame axes [kg·m²]." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60.0" y="68.9" width="1200.0" height="22.2" as="geometry"/></mxCell><mxCell id="c196" value="&lt;table style=&quot;border-collapse:collapse;font-family:Helvetica;font-size:11px;&quot; border=&quot;1&quot;&gt;&lt;tr style=&quot;background:#dae8fc;&quot;&gt;&lt;th style=&quot;padding:3px 6px;&quot;&gt;body&lt;/th&gt;&lt;th style=&quot;padding:3px 6px;&quot;&gt;moved by joint&lt;/th&gt;&lt;th style=&quot;padding:3px 6px;&quot;&gt;URDF links merged (mass, kg)&lt;/th&gt;&lt;th style=&quot;padding:3px 6px;&quot;&gt;m [kg]&lt;/th&gt;&lt;th style=&quot;padding:3px 6px;&quot;&gt;COM c in body frame [m]&lt;/th&gt;&lt;th style=&quot;padding:3px 6px;&quot;&gt;I&lt;sub&gt;xx&lt;/sub&gt;&lt;/th&gt;&lt;th style=&quot;padding:3px 6px;&quot;&gt;I&lt;sub&gt;yy&lt;/sub&gt;&lt;/th&gt;&lt;th style=&quot;padding:3px 6px;&quot;&gt;I&lt;sub&gt;zz&lt;/sub&gt;&lt;/th&gt;&lt;th style=&quot;padding:3px 6px;&quot;&gt;I&lt;sub&gt;xy&lt;/sub&gt;&lt;/th&gt;&lt;th style=&quot;padding:3px 6px;&quot;&gt