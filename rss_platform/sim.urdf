      </geometry>
    </visual>
    <collision>
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 -0.07"/>
      <geometry>
        <mesh filename="package://ur_description/meshes/ur20/collision/wrist3.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.926"/>
      <origin rpy="0 0 0" xyz="0.0 0.0 -0.0293"/>
      <inertia ixx="0.00092" ixy="0.0" ixz="0.0" iyy="0.00091" iyz="0.0" izz="0.00117"/>
    </inertial>
  </link>
  <!-- base_joint fixes base_link to the environment -->
  <joint name="han_base_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="han_tombstone_face"/>
    <child link="han_base_link"/>
  </joint>
  <!-- joints - main serial chain -->
  <joint name="han_base_link-base_link_inertia" type="fixed">
    <parent link="han_base_link"/>
    <child link="han_base_link_inertia"/>
    <!-- 'base_link' is REP-103 aligned (so X+ forward), while the internal
           frames of the robot/controller have X+ pointing backwards.
           Use the joint between 'base_link' and 'base_link_inertia' (a dummy
           link/frame) to introduce the necessary rotation over Z (of pi rad).
      -->
    <origin rpy="0 0 3.141592653589793" xyz="0 0 0"/>
  </joint>
  <joint name="han_shoulder_pan_joint" type="revolute">
    <parent link="han_base_link_inertia"/>
    <child link="han_shoulder_link"/>
    <origin rpy="0 0 1.0813043361136004e-07" xyz="0 0 0.23605804505849792"/>
    <axis xyz="0 0 1"/>
    <limit effort="738.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="2.0943951023931953"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="han_shoulder_lift_joint" type="revolute">
    <parent link="han_shoulder_link"/>
    <child link="han_upper_arm_link"/>
    <origin rpy="1.5708629459765144 0 -4.880508667138009e-06" xyz="9.754030555240492e-05 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="738.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="2.0943951023931953"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="han_elbow_joint" type="revolute">
    <parent link="han_upper_arm_link"/>
    <child link="han_forearm_link"/>
    <origin rpy="0.0005884295412275638 -0.0004267141440094013 -7.335107699104623e-08" xyz="-0.8610921552590647 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="433.0" lower="-3.141592653589793" upper="3.141592653589793" velocity="2.6179938779914944"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="han_wrist_1_joint" type="revolute">
    <parent link="han_forearm_link"/>
    <child link="han_wrist_1_link"/>
    <origin rpy="3.1405048492789644 3.141195896656006 -3.1415923332207147" xyz="-0.7278670242516039 0.00021723008103170053 0.19969583976195102"/>
    <axis xyz="0 0 1"/>
    <limit effort="107.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.6651914291880923"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="han_wrist_2_joint" type="revolute">
    <parent link="han_wrist_1_link"/>
    <child link="han_wrist_2_link"/>
    <origin rpy="1.57136726958501 0 7.582584195860861e-08" xyz="-3.309974135769099e-05 -0.159114862392224 -9.084549335387157e-05"/>
    <axis xyz="0 0 1"/>
    <limit effort="107.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.6651914291880923"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="han_wrist_3_joint" type="revolute">
    <parent link="han_wrist_2_link"/>
    <child link="han_wrist_3_link"/>
    <origin rpy="1.5707691133726167 3.141592653589793 3.1415924379608358" xyz="-7.181658624943694e-05 0.1539659637667372 -4.189940789732904e-06"/>
    <axis xyz="0 0 1"/>
    <limit effort="107.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.6651914291880923"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <link name="han_ft_frame"/>
  <joint name="han_wrist_3_link-ft_frame" type="fixed">
    <parent link="han_wrist_3_link"/>
    <child link="han_ft_frame"/>
    <origin rpy="3.141592653589793 0 0" xyz="0 0 0"/>
  </joint>
  <!-- ROS-Industrial 'base' frame - base_link to UR 'Base' Coordinates transform -->
  <link name="han_base"/>
  <joint name="han_base_link-base_fixed_joint" type="fixed">
    <!-- Note the rotation over Z of pi radians - as base_link is REP-103
           aligned (i.e., has X+ forward, Y+ left and Z+ up), this is needed
           to correctly align 'base' with the 'Base' coordinate system of
           the UR controller.
      -->
    <origin rpy="0 0 3.141592653589793" xyz="0 0 0"/>
    <parent link="han_base_link"/>
    <child link="han_base"/>
  </joint>
  <!-- ROS-Industrial 'flange' frame - attachment point for EEF models -->
  <link name="han_flange"/>
  <joint name="han_wrist_3-flange" type="fixed">
    <parent link="han_wrist_3_link"/>
    <child link="han_flange"/>
    <origin rpy="0 -1.5707963267948966 -1.5707963267948966" xyz="0 0 0"/>
  </joint>
  <!-- ROS-Industrial 'tool0' frame - all-zeros tool frame -->
  <link name="han_tool0"/>
  <joint name="han_flange-tool0" type="fixed">
    <!-- default toolframe - X+ left, Y+ up, Z+ front -->
    <origin rpy="1.5707963267948966 0 1.5707963267948966" xyz="0 0 0"/>
    <parent link="han_flange"/>
    <child link="han_tool0"/>
  </joint>
  <!-- Add URDF transmission elements (for ros_control) -->
  <!--<xacro:ur_arm_transmission prefix="${prefix}" hw_interface="${transmission_hw_interface}" />-->
  <!-- Placeholder for ros2_control transmission which don't yet exist -->
  <ros2_control name="han" type="system">
    <hardware>
      <plugin>mock_components/GenericSystem</plugin>
      <param name="mock_sensor_commands">True</param>
      <param name="state_following_offset">0.0</param>
      <param name="calculate_dynamics">true</param>
    </hardware>
    <joint name="han_shoulder_pan_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position">
        <!-- initial position for the mock system and simulation -->
        <param name="initial_value">0.139626</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="effort">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="han_shoulder_lift_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position">
        <!-- initial position for the mock system and simulation -->
        <param name="initial_value">0.907571</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="effort">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="han_elbow_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position">
        <!-- initial position for the mock system and simulation -->
        <param name="initial_value">-2.82743</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="effort">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="han_wrist_1_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position">
        <!-- initial position for the mock system and simulation -->
        <param name="initial_value">0.506145</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="effort">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="han_wrist_2_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position">
        <!-- initial position for the mock system and simulation -->
        <param name="initial_value">1.22173</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="effort">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="han_wrist_3_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position">
        <!-- initial position for the mock system and simulation -->
        <param name="initial_value">-1.0</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="effort">
        <param name="initial_value">0.0</param>
