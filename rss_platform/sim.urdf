      <origin rpy="0 0 0" xyz="-0.3394 0.0 0.2098"/>
      <inertia ixx="0.1467" ixy="0.00019" ixz="-0.05163" iyy="4.6659" iyz="4e-05" izz="4.6348"/>
    </inertial>
  </link>
  <link name="han_forearm_link">
